# Copie para .env na raiz quando usar docker compose.
# Gere uma SECRET_KEY única, com 32+ caracteres aleatórios.

SECRET_KEY=troque-por-uma-chave-super-secreta-com-mais-de-32-caracteres
FRONTEND_PORT=8080
BACKEND_WORKERS=2

# SQLite persistente no volume Docker:
DATABASE_URL=sqlite:////app/data/fnlifting.db

# Se usar o serviço PostgreSQL opcional:
# POSTGRES_DB=fnlifting
# POSTGRES_USER=fnlifting
# POSTGRES_PASSWORD=troque-por-uma-password-forte
# DATABASE_URL=postgresql+psycopg://fnlifting:troque-por-uma-password-forte@postgres:5432/fnlifting
# docker compose --profile postgres up --build

CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
ALLOWED_HOSTS=backend,localhost,127.0.0.1
SYNC_REMOTE_URL=
BACKUP_ENCRYPTION_KEY=gere-uma-chave-fernet-ou-deixe-o-sistema-gerar-localmente
STORAGE_PROVIDER=S3
STORAGE_BUCKET=fnlifting-production
STORAGE_ENDPOINT_URL=
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_SECURE=true
STORAGE_PUBLIC_BASE_URL=

# Integrações opcionais. Preencher apenas no ambiente real/seguro.
SERPAPI_ENABLED=false
SERPAPI_KEY=
SERPAPI_BASE_URL=https://serpapi.com/search
SERPAPI_TIMEOUT=8
SERPAPI_RATE_LIMIT_PER_MINUTE=20

GOOGLE_MAPS_API_KEY=

TRACCAR_ENABLED=false
TRACCAR_BASE_URL=
TRACCAR_USERNAME=
TRACCAR_PASSWORD=
TRACCAR_TOKEN=
TRACCAR_TIMEOUT=8
