APP_NAME=FNLIFTING Enterprise ERP
ENVIRONMENT=development
DEBUG=true
APP_VERSION=0.12.0
SECRET_KEY=replace-with-at-least-32-random-characters
DATABASE_URL=sqlite:///./data/fnlifting.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ALLOWED_HOSTS=localhost,127.0.0.1
AUTO_CREATE_SCHEMA=true
SECURITY_HEADERS_ENABLED=true
BACKUP_WARNING_HOURS=24
SYNC_REMOTE_URL=
BACKUP_ENCRYPTION_KEY=

# Mapas, pesquisa auxiliar e GPS físico
# Nunca coloque estas chaves em ficheiros versionados reais.
SERPAPI_ENABLED=false
SERPAPI_KEY=
SERPAPI_BASE_URL=https://serpapi.com/search
SERPAPI_TIMEOUT=8
SERPAPI_RATE_LIMIT_PER_MINUTE=20

GOOGLE_MAPS_API_KEY=

TRACCAR_ENABLED=false
TRACCAR_BASE_URL=
TRACCAR_USERNAME=
TRACCAR_PASSWORD=
TRACCAR_TOKEN=
TRACCAR_TIMEOUT=8

# PostgreSQL (cloud/fase de sincronização):
# DATABASE_URL=postgresql+psycopg://fnlifting:password@localhost:5432/fnlifting
