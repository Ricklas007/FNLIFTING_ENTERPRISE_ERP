# Copie para .env.staging apenas em ambiente local/staging.
# Não coloque segredos reais neste ficheiro versionado.

SECRET_KEY=troque-por-uma-chave-staging-com-mais-de-32-caracteres
BACKUP_ENCRYPTION_KEY=troque-por-uma-chave-backup-staging-com-mais-de-32

FRONTEND_PORT=8080
BACKEND_WORKERS=2

POSTGRES_DB=fnlifting_staging
POSTGRES_USER=fnlifting
POSTGRES_PASSWORD=troque-por-password-postgres-staging
DATABASE_URL=postgresql+psycopg://fnlifting:troque-por-password-postgres-staging@postgres:5432/fnlifting_staging

MINIO_ROOT_USER=fnlifting
MINIO_ROOT_PASSWORD=troque-por-password-minio-staging
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

STORAGE_PROVIDER=MINIO
STORAGE_BUCKET=fnlifting-staging
STORAGE_ENDPOINT_URL=http://minio:9000
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY_ID=fnlifting
STORAGE_SECRET_ACCESS_KEY=troque-por-password-minio-staging
STORAGE_SECURE=false

CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
ALLOWED_HOSTS=backend,localhost,127.0.0.1
SYNC_REMOTE_URL=http://backend:8000/api/v1/enterprise/sync

SERPAPI_ENABLED=false
SERPAPI_KEY=
GOOGLE_MAPS_API_KEY=
TRACCAR_ENABLED=false
TRACCAR_BASE_URL=
TRACCAR_USERNAME=
TRACCAR_PASSWORD=
TRACCAR_TOKEN=
