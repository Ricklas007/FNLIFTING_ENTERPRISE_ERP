# FNLIFTING map configuration example
# Copy selected values into frontend/.env.local for development.
# Do not commit real API keys.

VITE_MAP_MODE=auto
VITE_MAP_RENDERER=maplibre
VITE_MAP_ONLINE_PROVIDER=maplibre

# Preferred: full MapLibre style JSON URL from a licensed provider or own tile server.
VITE_MAP_STYLE_URL=

# Optional MapTiler key for dataviz-dark style.
VITE_MAPTILER_KEY=

# Optional raster tile URL template for MapLibre raster mode.
# Example: https://basemaps.cartocdn.com/dark_all/{z}/{x}/{y}.png
VITE_MAP_RASTER_TILE_URL=
VITE_MAP_ONLINE_ATTRIBUTION=© OpenStreetMap contributors © CARTO

# Google Maps official provider. This is online only.
VITE_GOOGLE_MAPS_ENABLED=false
VITE_GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAP_ID=
VITE_GOOGLE_ROUTES_ENABLED=false

# SerpApi is backend-only. Never put SERPAPI_KEY in Vite/frontend env files.
