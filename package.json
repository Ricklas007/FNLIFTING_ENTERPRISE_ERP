{
  "name": "fnlifting-enterprise-erp",
  "version": "0.12.1",
  "private": true,
  "description": "FNLIFTING Enterprise ERP desktop and mobile packaging",
  "main": "desktop/main.js",
  "author": "FNLIFTING",
  "scripts": {
    "build": "npm --prefix frontend run build",
    "desktop:backend:clean": "powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -File scripts/build-desktop-backend.ps1 -CleanOnly",
    "desktop:backend:build": "powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -File scripts/build-desktop-backend.ps1",
    "desktop:backend:smoke": "powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -File scripts/test-backend-standalone.ps1",
    "desktop:frontend:build": "npm --prefix frontend run build",
    "desktop:validate": "node desktop/validate-desktop.js",
    "desktop:dev": "npm run build && electron . --dev",
    "desktop:build": "npm run desktop:frontend:build && npm run desktop:backend:build && npm run desktop:validate",
    "desktop:pack": "npm run desktop:build && electron-builder --dir",
    "desktop:dist": "npm run desktop:build && electron-builder --win nsis",
    "desktop:smoke": "powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -File scripts/test-desktop-relaunch.ps1",
    "desktop:installed:smoke": "powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -File scripts/test-desktop-relaunch.ps1 -Installed",
    "app:start": "npm run desktop:dev",
    "mobile:init": "npm run build && cap add android",
    "mobile:sync": "npm run build && cap sync android",
    "android:open": "cap open android",
    "android:build": "powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -File scripts/build-android.ps1",
    "android:build:portable": "powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -File scripts/build-android.ps1 -InstallPortableJdk -InstallPortableAndroidSdk",
    "android:build:portable:accept-licenses": "powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -File scripts/build-android.ps1 -InstallPortableJdk -InstallPortableAndroidSdk -AcceptAndroidSdkLicenses"
  },
  "dependencies": {
    "@capacitor/core": "^7.4.3"
  },
  "devDependencies": {
    "@capacitor/android": "^7.4.3",
    "@capacitor/cli": "^7.4.3",
    "electron": "^37.2.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.fnlifting.enterprise.erp",
    "productName": "FNLIFTING ENTERPRISE ERP",
    "copyright": "Copyright © 2026 FNLIFTING",
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "frontend/dist",
        "to": "frontend/dist"
      },
      {
        "from": "backend-dist/FNLiftingBackend",
        "to": "backend/FNLiftingBackend"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "desktop/assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "FNLIFTING ENTERPRISE ERP",
      "artifactName": "FNLIFTING-ENTERPRISE-ERP-Setup-${version}.${ext}"
    }
  }
}
